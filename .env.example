# Copy this file to .env and fill in the three values. Never share or upload .env.

# The service's address, ending in /openai/v1/ on Azure or /v1/ elsewhere.
#   Azure AI Foundry: your resource's endpoint (Azure portal > your resource > Keys and Endpoint)
#                     plus /openai/v1/, e.g. https://<your-resource>.openai.azure.com/openai/v1/
#   OpenAI:           https://api.openai.com/v1/
#   Ollama (local):   http://localhost:11434/v1/
OPENAI_BASE_URL=

# The key from the same page (Azure: Key 1; OpenAI: platform.openai.com > API keys).
# Ollama needs no key, but the field can't be empty: write ollama.
OPENAI_API_KEY=

# The model to use. On Azure, the deployment name from the Deployments page.
MODEL=
